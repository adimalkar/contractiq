# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Termnova — Environment Configuration Template
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Database (PostgreSQL + pgvector) ──
# Local default port: 5432, Docker default port: 5433
DB_USER=aditya
DB_PASSWORD=
DB_NAME=termnova
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://aditya@localhost:5432/termnova
DATABASE_URL_SYNC=postgresql://aditya@localhost:5432/termnova

# ── Redis Cache & Session Store ──
# Local default port: 6379, Docker default port: 6380
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Configuration (openai | bedrock | ollama | mock) ──
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here

# ── AWS Bedrock (Optional) ──
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Ollama Local Models (Optional) ──
# OLLAMA_BASE_URL=http://localhost:11434

# ── Model & Embedding Dimensions ──
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── RAG Pipeline Parameters ──
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=50
TOP_K_RETRIEVAL=10
RELEVANCE_THRESHOLD=0.3
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# ── Application Runtime ──
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["*"]
